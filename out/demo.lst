   445 				;-----------------------------------------------------------------------------
   446 				; Set_Positions
   447 				; For each sprite: update position with sub-pixel accuracy, bounce off walls,
   448 				; compute VBXE address via Calculate_200, write to BLT_BALL BCB, fire blitter.
   449 				; X = ball index, used to index every Bob_* field array directly
   450 				;-----------------------------------------------------------------------------
   451 3446			Set_Positions
   452 3446 A9 80			lda #$80
   453 3448 8D 5F D6			sta VBXE_MA_BSEL					; Enable VBXE window for BCB writes
   454
   455 344B AD 05 24			lda VBXE_WINDOW+$405				; XDL Adr2 (byte 5 of XDL at VBXE_WINDOW+$400)
   456 344E 49 06			eor #$06							; Flip between $02 ($020000) and $04 ($040000)
   457 3450 85 86			sta Reg7							; Backbuffer Adr2 - constant for the whole frame
   458
   459 3452 A2 00			ldx #$00
   460
   461 3454			Spr_Loop
   462 3454 A5 8A			lda Do_Motion
   463 3456 D0 03			bne Set_X
   464 3458 4C FE 34			jmp Skip_Motion						; Long branch fix
   465
   466 				;--- X motion ----------------------------------------------------------------
   467 345B			Set_X
   468 345B 18				clc
   469 345C BD 00 55			lda Bob_X_Pos_Frac,x
   470 345F 7D 80 56			adc Bob_Delta_X_Frac,x
   471 3462 9D 00 55			sta Bob_X_Pos_Frac,x
   472
   473 3465 BD 40 55			lda Bob_X_Pos_Lo,x
   474 3468 7D C0 56			adc Bob_Delta_X,x
   475 346B 9D 40 55			sta Bob_X_Pos_Lo,x
   476
   477 346E BD 80 55			lda Bob_X_Pos_Hi,x
   478 3471 7D 40 56			adc Bob_Delta_X_Sign,x				; $00 = right, $FF = left
   479 3474 9D 80 55			sta Bob_X_Pos_Hi,x					; sta does not touch flags, so the adc's N survives
   480
   481 				; Left wall: X_Pos_Hi >= $80 means position underflowed past 0
   482 3477 10 16			bpl X_Check_Right
   483 3479 A9 00			lda #$00
   484 347B 9D 80 55			sta Bob_X_Pos_Hi,x
   485 347E 9D 40 55			sta Bob_X_Pos_Lo,x
   486 3481 9D 00 55			sta Bob_X_Pos_Frac,x
   487 3484 BD 40 56			lda Bob_Delta_X_Sign,x
   488 3487 10 2A			bpl X_Done							; Already heading right
   489 3489 20 12 34			jsr Reverse_X
   490 348C 4C B3 34			jmp X_Done
   491
   492 				; Right wall: clamp if X_Pos > $0120 (320 - 32 = 288)
   493 348F			X_Check_Right							; A still holds X_Pos_Hi from the add above
   494 348F C9 01			cmp #$01
   495 3491 90 20			bcc X_Done							; Hi < $01, in range
   496 3493 D0 07			bne X_Hit_Right						; Hi > $01, past right edge
   497 3495 BD 40 55			lda Bob_X_Pos_Lo,x
   498 3498 C9 21			cmp #$21							; Lo > $20?
   499 349A 90 17			bcc X_Done
   500 349C			X_Hit_Right
   501 349C A9 01			lda #$01
   502 349E 9D 80 55			sta Bob_X_Pos_Hi,x
   503 34A1 A9 20			lda #$20
   504 34A3 9D 40 55			sta Bob_X_Pos_Lo,x
   505 34A6 A9 00			lda #$00
   506 34A8 9D 00 55			sta Bob_X_Pos_Frac,x
   507 34AB BD 40 56			lda Bob_Delta_X_Sign,x
   508 34AE 30 03			bmi X_Done							; Already heading left
   509 34B0 20 12 34			jsr Reverse_X
   510 34B3			X_Done
   511
   512 				;--- Y motion ----------------------------------------------------------------
   513 34B3 18				clc
   514 34B4 BD C0 55			lda Bob_Y_Pos_Frac,x
   515 34B7 7D 40 57			adc Bob_Delta_Y_Frac,x
   516 34BA 9D C0 55			sta Bob_Y_Pos_Frac,x
   517
   518 34BD BD 00 56			lda Bob_Y_Pos,x
   519 34C0 7D 80 57			adc Bob_Delta_Y,x
   520 34C3 9D 00 56			sta Bob_Y_Pos,x
   521
   522 34C6 BD 00 57			lda Bob_Delta_Y_Sign,x
   523 34C9 30 1C			bmi Y_Check_Top
   524
   525 				; Moving down: clamp at Y_POS_MAX (CLEAR_ROWS - 32) so the ball's bottom row is
   526 				; still inside the area BLT_BAKGRND clears, or it would leave a permanent trail
   527 34CB			Y_Check_Bottom
   528 34CB BD 00 56			lda Bob_Y_Pos,x
   529 34CE C9 C9			cmp #Y_POS_MAX+1
   530 34D0 90 2C			bcc Y_Done
   531 34D2 A9 C8			lda #Y_POS_MAX
   532 34D4 9D 00 56			sta Bob_Y_Pos,x
   533 34D7 A9 00			lda #$00
   534 34D9 9D C0 55			sta Bob_Y_Pos_Frac,x
   535 34DC BD 00 57			lda Bob_Delta_Y_Sign,x
   536 34DF 30 1D			bmi Y_Done							; Already heading up
   537 34E1 20 2C 34			jsr Reverse_Y
   538 34E4 4C FE 34			jmp Y_Done
   539
   540 				; Moving up: underflow wraps Y_Pos above Y_POS_MAX
   541 34E7			Y_Check_Top
   542 34E7 BD 00 56			lda Bob_Y_Pos,x
   543 34EA C9 C9			cmp #Y_POS_MAX+1
   544 34EC 90 10			bcc Y_Done
   545 34EE A9 00			lda #$00
   546 34F0 9D 00 56			sta Bob_Y_Pos,x
   547 34F3 9D C0 55			sta Bob_Y_Pos_Frac,x
   548 34F6 BD 00 57			lda Bob_Delta_Y_Sign,x
   549 34F9 10 03			bpl Y_Done							; Already heading down
   550 34FB 20 2C 34			jsr Reverse_Y
   551 34FE			Y_Done
   552
