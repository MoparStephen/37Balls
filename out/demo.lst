   367 				;-----------------------------------------------------------------------------
   368 				; Set_Positions
   369 				; For each sprite: update position with sub-pixel accuracy, bounce off walls,
   370 				; compute VBXE address via Calculate_200, write to BLT_BALL BCB, fire blitter.
   371 				; X = object counter,  Ptr_Lo/Ptr_Hi = pointer to current Sprite struct
   372 				;-----------------------------------------------------------------------------
   373 33F6			Set_Positions
   374 33F6 A9 80			lda #$80
   375 33F8 8D 5F D6			sta VBXE_MA_BSEL					; Enable VBXE window for BCB writes
   376
   377 33FB A9 00			lda #<Bobs
   378 33FD 85 88			sta Ptr_Lo
   379 33FF A9 55			lda #>Bobs
   380 3401 85 89			sta Ptr_Hi
   381 3403 A2 00			ldx #$00
   382
   383 3405			Spr_Loop
   384 3405 A5 8A			lda Do_Motion
   385 3407 D0 03			bne Set_X
   386 3409 4C D4 34			jmp Skip_Motion						; Long branch fix
   387
   388 				;--- X motion ----------------------------------------------------------------
   389 340C			Set_X
   390 340C 18				clc
   391 340D A0 00			ldy #Spr_X_Pos_Frac
   392 340F B1 88			lda (Ptr_Lo),y
   393 3411 A0 06			ldy #Spr_Delta_X_Frac
   394 3413 71 88			adc (Ptr_Lo),y
   395 3415 A0 00			ldy #Spr_X_Pos_Frac
   396 3417 91 88			sta (Ptr_Lo),y
   397
   398 3419 A0 01			ldy #Spr_X_Pos_Lo
   399 341B B1 88			lda (Ptr_Lo),y
   400 341D A0 07			ldy #Spr_Delta_X
   401 341F 71 88			adc (Ptr_Lo),y
   402 3421 A0 01			ldy #Spr_X_Pos_Lo
   403 3423 91 88			sta (Ptr_Lo),y
   404
   405 3425 A0 02			ldy #Spr_X_Pos_Hi
   406 3427 B1 88			lda (Ptr_Lo),y
   407 3429 A0 05			ldy #Spr_Delta_X_Sign
   408 342B 71 88			adc (Ptr_Lo),y						; $00 = right, $FF = left
   409 342D A0 02			ldy #Spr_X_Pos_Hi
   410 342F 91 88			sta (Ptr_Lo),y
   411 3431 B1 88			lda (Ptr_Lo),y						; Reload to restore N flag (sta does not set N)
   412
   413 				; Left wall: X_Pos_Hi >= $80 means position underflowed past 0
   414 3433 10 1A			bpl X_Check_Right
   415 3435 A9 00			lda #$00
   416 3437 A0 02			ldy #Spr_X_Pos_Hi
   417 3439 91 88			sta (Ptr_Lo),y
   418 343B A0 01			ldy #Spr_X_Pos_Lo
   419 343D 91 88			sta (Ptr_Lo),y
   420 343F A0 00			ldy #Spr_X_Pos_Frac
   421 3441 91 88			sta (Ptr_Lo),y
   422 3443 A0 05			ldy #Spr_Delta_X_Sign
   423 3445 B1 88			lda (Ptr_Lo),y
   424 3447 10 33			bpl X_Done							; Already heading right
   425 3449 20 C2 33			jsr Reverse_X
   426 344C 4C 7C 34			jmp X_Done
   427
   428 				; Right wall: clamp if X_Pos > $0120 (320 - 32 = 288)
   429 344F			X_Check_Right
   430 344F A0 02			ldy #Spr_X_Pos_Hi
   431 3451 B1 88			lda (Ptr_Lo),y
   432 3453 C9 01			cmp #$01
   433 3455 90 25			bcc X_Done							; Hi < $01, in range
   434 3457 D0 08			bne X_Hit_Right						; Hi > $01, past right edge
   435 3459 A0 01			ldy #Spr_X_Pos_Lo
   436 345B B1 88			lda (Ptr_Lo),y
   437 345D C9 21			cmp #$21							; Lo > $20?
   438 345F 90 1B			bcc X_Done
   439 3461			X_Hit_Right
   440 3461 A9 01			lda #$01
   441 3463 A0 02			ldy #Spr_X_Pos_Hi
   442 3465 91 88			sta (Ptr_Lo),y
   443 3467 A9 20			lda #$20
   444 3469 A0 01			ldy #Spr_X_Pos_Lo
   445 346B 91 88			sta (Ptr_Lo),y
   446 346D A9 00			lda #$00
   447 346F A0 00			ldy #Spr_X_Pos_Frac
   448 3471 91 88			sta (Ptr_Lo),y
   449 3473 A0 05			ldy #Spr_Delta_X_Sign
   450 3475 B1 88			lda (Ptr_Lo),y
   451 3477 30 03			bmi X_Done							; Already heading left
   452 3479 20 C2 33			jsr Reverse_X
   453 347C			X_Done
   454
   455 				;--- Y motion ----------------------------------------------------------------
   456 347C 18				clc
   457 347D A0 03			ldy #Spr_Y_Pos_Frac
   458 347F B1 88			lda (Ptr_Lo),y
   459 3481 A0 09			ldy #Spr_Delta_Y_Frac
   460 3483 71 88			adc (Ptr_Lo),y
   461 3485 A0 03			ldy #Spr_Y_Pos_Frac
   462 3487 91 88			sta (Ptr_Lo),y
   463
   464 3489 A0 04			ldy #Spr_Y_Pos
   465 348B B1 88			lda (Ptr_Lo),y
   466 348D A0 0A			ldy #Spr_Delta_Y
   467 348F 71 88			adc (Ptr_Lo),y
   468 3491 A0 04			ldy #Spr_Y_Pos
   469 3493 91 88			sta (Ptr_Lo),y
   470
   471 3495 A0 08			ldy #Spr_Delta_Y_Sign
   472 3497 B1 88			lda (Ptr_Lo),y
   473 3499 30 1E			bmi Y_Check_Top
   474
   475 				; Moving down: clamp if Y_Pos > $D0 (240 - 32 = 208)
   476 349B			Y_Check_Bottom
   477 349B A0 04			ldy #Spr_Y_Pos
   478 349D B1 88			lda (Ptr_Lo),y
   479 349F C9 D1			cmp #$D1
   480 34A1 90 31			bcc Y_Done
   481 34A3 A9 D0			lda #$D0
   482 34A5 91 88			sta (Ptr_Lo),y
   483 34A7 A9 00			lda #$00
   484 34A9 A0 03			ldy #Spr_Y_Pos_Frac
   485 34AB 91 88			sta (Ptr_Lo),y
   486 34AD A0 08			ldy #Spr_Delta_Y_Sign
   487 34AF B1 88			lda (Ptr_Lo),y
   488 34B1 30 21			bmi Y_Done							; Already heading up
   489 34B3 20 DC 33			jsr Reverse_Y
   490 34B6 4C D4 34			jmp Y_Done
   491
   492 				; Moving up: underflow wraps Y_Pos above $D0
   493 34B9			Y_Check_Top
   494 34B9 A0 04			ldy #Spr_Y_Pos
   495 34BB B1 88			lda (Ptr_Lo),y
   496 34BD C9 D1			cmp #$D1
   497 34BF 90 13			bcc Y_Done
   498 34C1 A9 00			lda #$00
   499 34C3 A0 04			ldy #Spr_Y_Pos
   500 34C5 91 88			sta (Ptr_Lo),y
   501 34C7 A0 03			ldy #Spr_Y_Pos_Frac
   502 34C9 91 88			sta (Ptr_Lo),y
   503 34CB A0 08			ldy #Spr_Delta_Y_Sign
   504 34CD B1 88			lda (Ptr_Lo),y
   505 34CF 10 03			bpl Y_Done							; Already heading down
   506 34D1 20 DC 33			jsr Reverse_Y
   507 34D4			Y_Done
   508
   509 				;--- Compute VBXE address and blit -------------------------------------------
   510 34D4			Skip_Motion								; Jump here to bypass ball motion
   511 34D4 A0 01			ldy #Spr_X_Pos_Lo
   512 34D6 B1 88			lda (Ptr_Lo),y
   513 34D8 85 80			sta Reg1							; X_Pos_Lo â†’ Calculate_200 input
   514 34DA A0 02			ldy #Spr_X_Pos_Hi
   515 34DC B1 88			lda (Ptr_Lo),y
   516 34DE 85 81			sta Reg2							; X_Pos_Hi â†’ Calculate_200 input
   517 34E0 A0 04			ldy #Spr_Y_Pos
   518 34E2 B1 88			lda (Ptr_Lo),y
   519 34E4 85 82			sta Reg3							; Y_Pos    â†’ Calculate_200 input
   520
   521 34E6 20 84 36			jsr Calculate_200					; â†’ Reg4=Adr0, Reg5=Adr1, Reg6=Adr2
   522
   523 34E9 A5 83			lda Reg4
   524 34EB 8D 06 25			sta VBXE_WINDOW+$500+BLT_BALL-BLT_BALL+Dest_Adr0
   525 34EE A5 84			lda Reg5
   526 34F0 8D 07 25			sta VBXE_WINDOW+$500+BLT_BALL-BLT_BALL+Dest_Adr1
   527 34F3 A5 85			lda Reg6
   528 34F5 8D 08 25			sta VBXE_WINDOW+$500+BLT_BALL-BLT_BALL+Dest_Adr2
   529
   530 34F8 20 D7 35			jsr Draw_Sprite						; Wait for blitter idle then fire BLT_BALL
   531
   532 				;--- Advance Ptr to next sprite ----------------------------------------------
   533 34FB 18				clc
   534 34FC A5 88			lda Ptr_Lo
   535 34FE 69 0B			adc #Sprite_Size
   536 3500 85 88			sta Ptr_Lo
   537 3502 90 02			bcc No_Hi_Bump
   538 3504 E6 89			inc Ptr_Hi
   539 3506			No_Hi_Bump
   540 3506 E8				inx
   541 3507 E4 8B			cpx Num_Sprites
   542 3509 F0 03			beq Spr_Loop_Done					; All sprites done
   543 350B 4C 05 34			jmp Spr_Loop						; Long branch workaround (loop body > 127 bytes)
   544 350E			Spr_Loop_Done
   545 350E A9 00			lda #$00
   546 3510 8D 5F D6			sta VBXE_MA_BSEL					; Disable VBXE window
   547 3513 60				rts
