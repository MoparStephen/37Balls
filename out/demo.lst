   556
   557 3501 A5 83			lda Reg4
   558 3503 8D 06 25			sta VBXE_WINDOW+$500+BLT_BALL-BLT_BALL+Dest_Adr0
   559 3506 A5 84			lda Reg5
   560 3508 8D 07 25			sta VBXE_WINDOW+$500+BLT_BALL-BLT_BALL+Dest_Adr1
   561 350B A5 85			lda Reg6
   562 350D 8D 08 25			sta VBXE_WINDOW+$500+BLT_BALL-BLT_BALL+Dest_Adr2
   563
   564 3510 20 B4 35			jsr Draw_Sprite						; Wait for blitter idle then fire BLT_BALL
