   428 				;-----------------------------------------------------------------------------
   429 				; Reverse_Y - 2's complement negate of Delta_Y_Sign:Delta_Y:Delta_Y_Frac
   430 				; X = ball index
   431 				;-----------------------------------------------------------------------------
   432 342C			Reverse_Y
   433 342C 38				sec
   434 342D A9 00			lda #$00
   435 342F FD 40 57			sbc Bob_Delta_Y_Frac,x
   436 3432 9D 40 57			sta Bob_Delta_Y_Frac,x
   437 3435 A9 00			lda #$00
   438 3437 FD 80 57			sbc Bob_Delta_Y,x
   439 343A 9D 80 57			sta Bob_Delta_Y,x
   440 343D BD 00 57			lda Bob_Delta_Y_Sign,x
   441 3440 49 FF			eor #$FF
   442 3442 9D 00 57			sta Bob_Delta_Y_Sign,x
   443 3445 60				rts
