   151 				;VBXE_Detect - detects VBXE FX core version 1.07 and above,
   152 				; and stores VBXE Base address in VBXEBase
   153 312B			VBXE_Detect
   154 312B A9 00			lda #$00
   155 312D A2 D6			ldx #$D6
   156 312F 8D 40 D6			sta $D640							; Make sure it isn't coincidence
   157 3132 AD 40 D6			lda $D640
   158 3135 C9 10			cmp #$10							; Do we have major version here?
   159 3137 F0 15			beq VBXE_Detected					; If so, then VBXE is detected
   160 3139 A9 00			lda #$00
   161 313B E8				inx
   162 313C 8D 40 D7			sta $D740							; No such luck, try other location
   163 313F AD 40 D7			lda $D740
   164 3142 C9 10			cmp #$10
   165 3144 F0 08			beq VBXE_Detected
   166 3146 A2 00			ldx #$00							; Not here, so not present or FX core version too low
   167 3148 86 92			stx VBXEBase+1
   168 314A 86 91			stx VBXEBase
   169 314C 38				sec
   170 314D 60				rts
   171 314E			VBXE_Detected:
   172 314E 86 92			stx VBXEBase+1
   173 3150 A9 00			lda #$00
   174 3152 85 91			sta VBXEBase
   175 3154				vblda VBXE_MINOR					; Get core minor version
