   822 				;-----------------------------------------------------------------------------
   823 				; Calculate_200
   824 				;   X    = ball index; X_Pos_Lo/Hi and Y_Pos are read straight from the Bob_*
   825 				;          arrays, so this routine is specific to the ball loop (its only caller)
   826 				;   Reg7 = backbuffer Adr2, computed once per frame by Set_Positions
   827 				;   Reg4 = Adr0	   VBXE Blitter Address
   828 				;   Reg5 = Adr1	   VBXE Blitter Address
   829 				;   Reg6 = Adr2	   VBXE Blitter Address
   830 				;-----------------------------------------------------------------------------
   831 3691			Calculate_200
   832 				; The VBXE window is already bank $00 with global enable - Set_Positions sets
   833 				; VBXE_MA_BSEL before the loop and only clears it once every ball is drawn.
   834
   835 				; Calculate the start of VRAM (Reg4, Reg5, Reg6) for the given Y-Pos
   836 3691 A9 00			lda #$00
   837 3693 85 83			sta Reg4							; Reset to initial value
   838 3695 85 85			sta Reg6							; Reset to initial value
   839 3697 BD 00 56			lda Bob_Y_Pos,x						; Y_Pos
   840 369A 10 02			bpl Skip_Reg6						; If A <= $7F Reg6 will be 0
   841 369C E6 85			inc Reg6							; Else Reg6 = 1 (leaves A and Y alone)
   842 369E			Skip_Reg6
   843 369E 0A				asl									; Multiply by 2
   844 369F 85 84			sta Reg5
   845
   846 				; Now move into that line in VRAM based on the X-Position
   847 36A1 18				clc									; Prepare to add
   848 36A2 BD 40 55			lda Bob_X_Pos_Lo,x					; X_Pos_L
   849 36A5 65 83			adc Reg4							; Add Adr0
   850 36A7 85 83			sta Reg4							; Store it
   851 36A9 BD 80 55			lda Bob_X_Pos_Hi,x					; X_Pos_H
   852 36AC 65 84			adc Reg5							; Add Adr1
   853 36AE 85 84			sta Reg5							; Store it
   854 36B0 A9 00			lda #$00
   855 36B2 65 85			adc Reg6							; Account for overflow
   856 36B4 85 85			sta Reg6							; Store Adr2
   857
   858 				; Set Adr 2 depending on which buffer we are writing to
   859 36B6 18				clc									; Prepare to add
   860 36B7 A5 86			lda Reg7
   861 36B9 65 85			adc Reg6							; Carry flag weill NEVER be set, as value will only ever be 0-1 or 2-3
   862 36BB 85 85			sta Reg6
   863 36BD			Calculate_200_End						; TODO: Re-measure - the bank save/restore and the XDL read are now hoisted into Set_Positions
   864 36BD 60				rts
   865
   866 				;-----------------------------------------------------------------------------
   867 				; Setup_DisplayList - Points ANTIC to a Display List that will be in VBXE RAM
   868 				;-----------------------------------------------------------------------------
   869 36BE			Setup_DisplayList
   870 36BE AD 2F 02			lda SDMCTL
   871 36C1 48				pha									; Save it
   872
   873 36C2 A9 00			lda #$00							; Turn off ANTIC DMA
   874 36C4 8D 2F 02			sta SDMCTL							; To safely set SDLSTL
   875
   876 36C7 A9 00			lda <Display_List
   877 36C9 8D 30 02			sta SDLSTL
   878 36CC A9 59			lda >Display_List
   879 36CE 8D 31 02			sta SDLSTH
   880
   881 36D1 68				pla									; Restore it
   882 36D2 8D 2F 02			sta SDMCTL
   883
   884 36D5 60				rts									; Go Home
