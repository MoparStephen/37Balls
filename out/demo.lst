   357 				; Update Progress bar - line 5 (y = $CB + (5 * increment #))
   358 330F A4 80			ldy Reg1
   359 3311 A9 54			lda #$54							; Screen RAM code for Ctrl+T
   360 3313 A2 05			ldx #$05							; Number of dots to write
   361 3315			Progress_Bar_Loop
   362 3315 91 88			sta (Ptr_Lo),y
   363 3317 C8				iny
   364 3318 CA				dex
   365 3319 D0 FA			bne Progress_Bar_Loop
   366 331B 84 80			sty Reg1							; Save pointer for progress bar updates
   367
   368 				; Set the base address of MEMA window to VBXE_WINDOW
   369 				; Size to 4k and accesible only by CPU
   370 331D A9 28			lda #>VBXE_WINDOW + 8
   371 331F 8D 5E D6			sta VBXE_MA_CTL
   372
   373 3322 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE		; Bank $00 VBXE Window Enabled
   374 3324 8D 5F D6			sta VBXE_MA_BSEL
   375
   376 					; Copy blit to VBXE memory
   377 3327 A2 14			ldx #$14
   378 3329 BD 4D 33 9D 00 20 + 	mva:rpl blit_clear,x VBXE_WINDOW,x-
   379
   380 					; Kick blit
   381 3332 A9 00			lda #$00
   382 3334 8D 50 D6			sta VBXE_BL_ADR0
   383 3337 8D 51 D6			sta VBXE_BL_ADR1
   384 333A 8D 52 D6			sta VBXE_BL_ADR2
   385 333D A9 01			lda #$01
   386 333F 8D 53 D6			sta VBXE_BLITTER_START				; Start the blit
   387
   388 					; Wait for blit complete
   389 3342 AD 53 D6 D0 FB		lda:rne VBXE_BLITTER_BUSY
   390
   391 3347 A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   392 3349 8D 5F D6			sta VBXE_MA_BSEL
   393
   394 334C 60				rts									; Return controll to loader
   395
   396 334D			blit_clear
   397 					; clear 496kB (leave bottom 16kB for the SVBXE.SYS driver)
   398 					; 496x16 zoom 8x8 clear blit (this takes 2 frames)
   399
   400 					;	dta e($00000)	; Source address
   401 					;	dta a($0000)	; Source step y
   402 					;	dta 0			; Source step x
   403 					;	dta e($7BFFF)	; Destination address
   404 					;	dta a(-$0F80)	; Destination step y (backwards 3968 bytes) - NOTE: this equals 496 * zoom factor of 8
   405 					;	dta -1			; Destination step x (backwards	1 byte)
   406 					;	dta a($01EF)	; Width-1  (495)	496 * 8 bytes wide
   407 					;	dta $0F			; Height-1 (15)		 16 * 8 bytes high
   408 					;	dta $00			; And mask (And mask equal to 0 so clear)
   409 					;	dta $00			; Xor mask (will be filled with xor mask)
   410 					;	dta $00			; Collision and mask
   411 					;	dta $77			; Zoom (BLT_ZOOMY = 7, BLT_ZOOMX = 7 so 8Y*8X)
   412 					;	dta $00			; Pattern feature
   413 					;	dta $00			; Control (Mode 0 with NEXT bit Cleared)
   414
   415 334D 00 00 00 00 00 00 + 	dta e($00000), a($0000), 0, e($7BFFF), a(-$0F80), -1, a($01EF), $0F, $00, $00, $00, $77, $00, $00
   416 3362			Clearing_Message
   417 3362 23 6C 65 61 72 69 + 	.sb 'Clearing VBXE RAM                '
   418
   419 				.endp
