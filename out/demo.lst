   555 3514 A9 00			lda #<Bobs
   556 3516 85 88			sta Ptr_Lo
   557 3518 A9 55			lda #>Bobs
   558 351A 85 89			sta Ptr_Hi
   559 351C A2 00			ldx #$00
   560
   561 351E			Init_Spr_L
   562 					; X position from tables - Frac always 0, Pos_Hi always 0
   563 351E 8A				txa
   564 351F A8				tay
   565 3520 B9 DB 37			lda Init_Pos_X_Lo,y
   566 3523 A0 01			ldy #Spr_X_Pos_Lo
   567 3525 91 88			sta (Ptr_Lo),y
   568 3527 A9 00			lda #$00
   569 3529 A0 00			ldy #Spr_X_Pos_Frac
