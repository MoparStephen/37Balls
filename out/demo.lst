   271 3339 A9 FF			lda #$FF							; Must set priority when using Attribute Map
   272 333B 8D 55 D6			sta VBXE_P0							; because VBXE defaults PO-P$ to #$00 on power-up
   273
   274 				; Pre-fill both screen buffers with the background before animation starts
   275 333E 20 5E 35			jsr Flip_Screen
   276 3341 20 29 36			jsr Clear_Screen					; Draw background
   277 3344 20 5E 35			jsr Flip_Screen
   278 3347 20 29 36			jsr Clear_Screen					; Draw background
   279
   280 334A 20 D6 36			jsr Generate_Colour_Map				; So we don't have a boring monochrome background
   281
   282 334D 20 21 35			jsr Init_Objects					; Initialise all sprite structs
   283
   284 				; Point the buffer to the currently being displayed screen
   285 3350 A9 80			lda #$80							; Bank $00 with global enable (XDL lives in bank $00)
   286 3352 8D 5F D6			sta VBXE_MA_BSEL
   287
   288 3355 AD 05 24			lda VBXE_WINDOW + $405				; XDL Adr2 (byte 5 of XDL at VBXE_WINDOW+$400)
   289 3358 49 06			eor #$06							; Flip between $02 ($020000) and $04 ($040000)
   290 335A 8D 05 24			sta VBXE_WINDOW + $405				; XDL Adr2 (byte 5 of XDL at VBXE_WINDOW+$400)
   291
   292 				; Draw the initial bobs to the screen being displayed
   293 335D 20 46 34			jsr Set_Positions					; Update positions, bounce, write BCBs, blit all sprites
   294
   295 				; Set it back
   296 3360 A9 80			lda #$80							; Bank $00 with global enable (XDL lives in bank $00)
   297 3362 8D 5F D6			sta VBXE_MA_BSEL
   298
   299 3365 AD 05 24			lda VBXE_WINDOW + $405				; XDL Adr2 (byte 5 of XDL at VBXE_WINDOW+$400)
   300 3368 49 06			eor #$06							; Flip between $02 ($020000) and $04 ($040000)
   301 336A 8D 05 24			sta VBXE_WINDOW + $405				; XDL Adr2 (byte 5 of XDL at VBXE_WINDOW+$400)
