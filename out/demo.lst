   781 3649 8D 50 D6			sta VBXE_BL_ADR0					; Setup the blitter for memory fill operation
   782 364C A9 00			lda #$00
   783 364E 8D 52 D6			sta VBXE_BL_ADR2					; See the description of BCB at the end of this
   784 3651 A9 05			lda #$05							; Source
   785 3653 8D 51 D6			sta VBXE_BL_ADR1
   786 3656 A9 00			lda #$00
   787 3658			Setup_Cmap1_L1
   788 3658 AD 53 D6			lda VBXE_BLITTER_BUSY
   789 365B C9 00			cmp #$00
   790 365D D0 F9			bne Setup_Cmap1_L1					; Wait for blitter to finish
   791 365F A9 01			lda #$01
   792 3661 8D 53 D6			sta VBXE_BLITTER_START				; Start the blit
   793 3664			Setup_Cmap1_L2
   794 3664 AD 53 D6			lda VBXE_BLITTER_BUSY
   795 3667 C9 00			cmp #$00
   796 3669 D0 F9			bne Setup_Cmap1_L2					; Wait for blitter to finish before returning
   797 366B 60				rts
