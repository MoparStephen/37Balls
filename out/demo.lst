   306 3371			Delay_Start
   307 3371 20 03 44			jsr music.play						; Play a frame of music
   308 3374 20 CE 35			jsr Wait_For_Sync
   309 3377 C6 80			dec Reg1
   310 3379 D0 F6			bne Delay_Start
   311
   312 337B AD 87 04			lda Video_Flag
   313 337E F0 04			beq Set_Do_Motion					; If PAL skip next 2 lines
   314
   315 3380 A9 18			lda #MAX_SPRITES_NTSC				; Else limit # of sprites being shown
   316 3382 85 8B			sta Num_Sprites
