   318 3384			Set_Do_Motion
   319 3384 A9 01			lda #$01
   320 3386 85 8A			sta Do_Motion						; Allow positions to update when blitting
   321
   322 				.if DBG_FRAME_CHECK
   323 3388 A5 14			lda RTCLOK+2
   324 338A 8D 8A 04			sta Frame_Mark						; Seed the frame-slip check
   325 338D A9 00			lda #$00
   326 338F 8D 8C 04			sta Frame_Drops
   327 3392 8D 8B 04			sta Frame_Late
   328 3395 8D C8 02			sta COLOR4							; Border black = on time, never dropped
   329 				.endif
   330
   331 3398			Main_Loop
   332 3398 A9 00			lda #$00
   333 339A 85 4D			sta ATRACT							; Disable Screensaver
   334
   335 				; Do all the work
   336 339C 20 03 44			jsr music.play						; Play a frame of music
   337 339F 20 46 34			jsr Set_Positions					; Update positions, bounce, write BCBs, blit all sprites
   338 33A2 20 5E 35			jsr Flip_Screen						; Swap buffers
   339 33A5 20 29 36			jsr Clear_Screen					; Redraw background
   340
   341 				; Work done -wait for vertical synch before looping again
   342 33A8			W_Synch_0
   343 33A8 20 CE 35			jsr Wait_For_Sync					; Wait for VSYNC, Q quits
   344
   345 				.if DBG_FRAME_CHECK
   346 				; Frame-slip check.  Wait_For_Sync syncs on VCOUNT bit 7 (scanline 256) and so
   347 				; cannot see an overrun - it just waits for the next scanline 256 and silently
   348 				; loses a frame.  RTCLOK+2 is the OS VBI's own 50Hz tick and is the ground truth.
   349 				; The VBI fires around scanline 249, before our sync point, so this sample is
   350 				; race-free.  Delta of 1 = on time, N = we dropped N-1 frames.
   351 33AB A5 14			lda RTCLOK+2
   352 33AD A8				tay									; Keep the raw sample
   353 33AE 38				sec
   354 33AF ED 8A 04			sbc Frame_Mark						; Frames elapsed since the previous sync
   355 33B2 8C 8A 04			sty Frame_Mark						; Re-mark for next time
   356 33B5 C9 02			cmp #$02
   357 33B7 90 15			bcc Frame_On_Time					; Delta 1 - we made it
   358 33B9 8D 8B 04			sta Frame_Late
   359 33BC AD 8C 04			lda Frame_Drops
   360 33BF C9 FF			cmp #$FF
   361 33C1 F0 03			beq Frame_Red						; Saturate, do not wrap
   362 33C3 EE 8C 04			inc Frame_Drops
   363 33C6			Frame_Red
   364 33C6 A9 32			lda #$32							; Red - this frame overran
   365 33C8 8D C8 02			sta COLOR4
   366 33CB 4C E5 33			jmp Frame_Show
   367 33CE			Frame_On_Time
   368 33CE A9 00			lda #$00
   369 33D0 8D 8B 04			sta Frame_Late
   370 33D3 AD 8C 04			lda Frame_Drops
   371 33D6 F0 08			beq Frame_Black
   372 33D8 A9 1C			lda #$1C							; Yellow - on time now, but dropped earlier
   373 33DA 8D C8 02			sta COLOR4
   374 33DD 4C E5 33			jmp Frame_Show
   375 33E0			Frame_Black
   376 33E0 A9 00			lda #$00							; Black - clean since the last reset
   377 33E2 8D C8 02			sta COLOR4
   378 33E5			Frame_Show
   379 				.endif
   380
   381 33E5 A9 FF			lda #$FF
   382 33E7 8D FC 02			sta CH
   383 33EA A9 00			lda #DBG_SINGLE_STEP
   384 33EC F0 0F			beq Dont_Wait_Space_0
   385 33EE			Wait_Space_0
   386 33EE A9 00			lda #$00
   387 33F0 85 4D			sta ATRACT							; Disable screensaver
   388 33F2 AD FC 02			lda CH
   389 33F5 C9 2F			cmp #$2F							; Press Q to quit
   390 33F7 F0 07			beq Exit
   391 33F9 C9 21			cmp #$21							; Press Space to start
   392 33FB D0 F1			bne Wait_Space_0
   393 33FD			Dont_Wait_Space_0
   394 33FD 4C 98 33			jmp Main_Loop						; Animate forever
   395
   396 				; This is where we exit
   397 3400			Exit
   398 3400 A9 FF			lda #$FF
   399 3402 8D FC 02			sta CH								; Clear last key pressed
   400
   401 3405 A9 00			lda #$00
   402 3407 8D 40 D6			sta VBXE_VIDEO_CONTROL				; Disable XDL
   403 340A A9 00			lda #$00
   404 340C 8D 5F D6			sta VBXE_MA_BSEL					; Restore main memory (and disable VBXE memory window at VBXE_WINDOW)
   405
   406 340F 6C 0A 00			jmp (DOSVEC)						; Good bye ;)
