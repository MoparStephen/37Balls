   303 339E A9 00			lda #$00
   304 33A0 85 4D			sta ATRACT							; Disable screensaver
   305 33A2 AD FC 02			lda CH
   306 33A5 C9 2F			cmp #$2F							; Press Q to quit
   307 33A7 F0 07			beq Exit
   308 33A9 C9 21			cmp #$21							; Press Space to start
   309 33AB D0 F1			bne Wait_Space_0
   310 33AD			Dont_Wait_Space_0
   311 33AD 4C 82 33			jmp Main_Loop						; Animate forever
   312
   313 				; This is where we exit
   314 33B0			Exit
   315 33B0 A9 FF			lda #$FF
   316 33B2 8D FC 02			sta CH								; Clear last key pressed
   317
   318 33B5 A9 00			lda #$00
   319 33B7 8D 40 D6			sta VBXE_VIDEO_CONTROL				; Disable XDL
   320 33BA A9 00			lda #$00
   321 33BC 8D 5F D6			sta VBXE_MA_BSEL					; Restore main memory (and disable VBXE memory window at VBXE_WINDOW)
   322
   323 33BF 6C 0A 00			jmp (DOSVEC)						; Good bye ;)
