   198 					sta SP2_CG1							; high-byte position already - no +1
   199 					sta SP2_CB1
   200 					sta SP2_CR2
   201 					sta SP2_CG2
   202 					sta SP2_CB2
   203 					sta SP2_CR3
   204 					sta SP2_CG3
   205 					sta SP2_CB3
   206 					lda #$00							; Patching above clobbered A - restore it,
   207 				.endif									; tay below needs #$00 to zero the loop index
   208
