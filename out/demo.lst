   934 				;-----------------------------------------------------------------------------
   935 				; Setup_Colours
   936 				; Uses the temp table at $600 to setup the Attribute Colour Map
   937 				;-----------------------------------------------------------------------------
   938 3712			Setup_Colours
   939 				; Turn on VBXE window so we can modify the BCB
   940 3712 A9 80			lda #$80							; Copy some data into VBXE address space (XDL, Blitter control blocks (BCB))
   941 3714 8D 5F D6			sta VBXE_MA_BSEL
   942
   943 3717 A2 00			ldx #$00							; Prepare to loop
   944 3719			Setup_Colours_L1
   945 3719 BD 00 06			lda $600,x							; Get the colour
   946 371C 8D 64 25			sta VBXE_WINDOW+$554+$10			; BLT_SETUP_CMAP_2 starts at $0554 in VBXE bank 0, XOR Mask is offset $10
   947
   948 371F 20 6C 36			jsr Setup_Cmap2						; Setup a row of colours
   949
   950 				; Now we must do a 24-bit addition to get the next Destination Address (offset 6,7,8)
   951 3722 18				clc
   952 3723 AD 5A 25			lda VBXE_WINDOW+$554+$06			; Dest Addr 2
   953 3726 69 28			adc #$28							; Advance by one line ($28 bytes/line)
   954 3728 8D 5A 25			sta VBXE_WINDOW+$554+$06			; Dest Addr 2
   955
   956 372B AD 5B 25			lda VBXE_WINDOW+$554+$07			; Dest Addr 1
   957 372E 69 00			adc #$00
   958 3730 8D 5B 25			sta VBXE_WINDOW+$554+$07			; Dest Addr 1
   959
   960 3733 AD 5C 25			lda VBXE_WINDOW+$554+$08			; Dest Addr 0
   961 3736 69 00			adc #$00
   962 3738 8D 5C 25			sta VBXE_WINDOW+$554+$08			; Dest Addr 1
   963
   964 373B E8				inx
   965 373C E0 EF			cpx #$EF
   966 373E D0 D9			bne Setup_Colours_L1
   967
   968 3740 60				rts
