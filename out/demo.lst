   758 				; Clear_Screen via blitter
   759 				;-----------------------------------------------------------------------------
   760 3629			Clear_Screen
   761 3629 A9 15			lda #BLT_BAKGRND-BLT_BALL
   762 362B 8D 50 D6			sta VBXE_BL_ADR0					; Setup the blitter for memory fill operation
   763 362E A9 00			lda #$00
   764 3630 8D 52 D6			sta VBXE_BL_ADR2					; See the description of BCB at the end of this
   765 3633 A9 05			lda #$05							; Source
   766 3635 8D 51 D6			sta VBXE_BL_ADR1
   767 3638 A9 00			lda #$00
   768 363A			Clear_Screen_L1
   769 363A AD 53 D6			lda VBXE_BLITTER_BUSY
   770 363D C9 00			cmp #$00
   771 363F D0 F9			bne Clear_Screen_L1					; Wait for blitter to finish
   772 3641 A9 01			lda #$01
   773 3643 8D 53 D6			sta VBXE_BLITTER_START				; Start the blit
   774 3646 60				rts
