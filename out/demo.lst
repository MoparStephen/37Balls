   804 366E 8D 50 D6			sta VBXE_BL_ADR0					; Setup the blitter for memory fill operation
   805 3671 A9 00			lda #$00
   806 3673 8D 52 D6			sta VBXE_BL_ADR2					; See the description of BCB at the end of this
   807 3676 A9 05			lda #$05							; Source
   808 3678 8D 51 D6			sta VBXE_BL_ADR1
   809 367B A9 00			lda #$00
   810 367D			Setup_Cmap2_L1
   811 367D AD 53 D6			lda VBXE_BLITTER_BUSY
   812 3680 C9 00			cmp #$00
