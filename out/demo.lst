   179 				;-----------------------------------------------------------------------------
   180 				; VBXE_SetPalette2 - sets palette
   181 				;	A			- palette number
   182 				;	Y_Register	- palette pointer - Data MUST be page aligned
   183 				; NOTE: This code can run from ROM
   184 				;       The palette is stored as 256 RGB triplets
   185 				; NOTE (__VBXE_AUTO__ mode): the CR/CG/CB stores below use plain sta.w, not
   186 				; vbsta - this loop needs Y as its data index every iteration, and vbsta's
   187 				; (VBXEBase),Y addressing would clobber it every store. Instead the high
   188 				; byte of all nine store operands is patched ONCE per call (self-modifying,
   189 				; but off the hot path) so the loop itself runs at plain absolute-store cost.
   190 3159			VBXE_SetPalette2
   191 3159				vbsta VBXE_PSEL						; Set Palette 1
Macro: VBSTA [Source: vbxe_min.asm]
     5 3159 8D 45 D6			sta.w VBXE_PSEL
Source: vbxe_min.asm
   192 315C A9 00			lda #$00
   193 315E				vbsta VBXE_CSEL						; Start at colour 0
Macro: VBSTA [Source: vbxe_min.asm]
     5 315E 8D 44 D6			sta.w VBXE_CSEL
Source: vbxe_min.asm
   194
   195 				.ifdef	__VBXE_AUTO__
   196 					lda VBXEBase+1
   197 					sta SP2_CR1							; SP2_xxN labels equ *-1 to the store's
   198 					sta SP2_CG1							; high-byte position already - no +1
   199 					sta SP2_CB1
   200 					sta SP2_CR2
   201 					sta SP2_CG2
   202 					sta SP2_CB2
   203 					sta SP2_CR3
   204 					sta SP2_CG3
   205 					sta SP2_CB3
   206 					lda #$00							; Patching above clobbered A - restore it,
   207 				.endif									; tay below needs #$00 to zero the loop index
   208
   209 3161 A8				tay
   210 3162 B1 93		LoadPal1_1 lda (Y_Register),y
   211 3164 8D 46 D6			sta.w VBXE_CR						; Set the red component
   212 = 3166			SP2_CR1	equ *-1
   213 3167 C8				iny
   214 3168 F0 3B			beq OverFlow1						; Since 256 / 3 is not even, we must skip to next section and resume at CG
   215 316A B1 93			lda (Y_Register),y
   216 316C 8D 47 D6			sta.w VBXE_CG						; Set the green component
   217 = 316E			SP2_CG1	equ *-1
   218 316F C8				iny
   219 3170 B1 93			lda (Y_Register),y
   220 3172 8D 48 D6			sta.w VBXE_CB						; Set the blue component and increment CSEL
   221 = 3174			SP2_CB1	equ *-1
   222 3175 C8				iny
   223 3176 D0 EA			bne LoadPal1_1						; Copy a page
   224 3178 B1 93		LoadPal1_2 lda (Y_Register),y
   225 317A 8D 46 D6			sta.w VBXE_CR						; Set the red component
   226 = 317C			SP2_CR2	equ *-1
   227 317D C8				iny
   228 317E F0 10			beq LoadPal1_3
   229 3180			LP1_2_G
   230 3180 B1 93			lda (Y_Register),y
   231 3182 8D 47 D6			sta.w VBXE_CG						; Set the green component
   232 = 3184			SP2_CG2	equ *-1
   233 3185 C8				iny
   234 3186 F0 22			beq OverFlow2						; Since 256 / 3 is not even, we must skip to next section and resume at CB
   235 3188 B1 93			lda (Y_Register),y
   236 318A 8D 48 D6			sta.w VBXE_CB						; Set the blue component and increment CSEL
   237 = 318C			SP2_CB2	equ *-1
   238 318D C8				iny
   239 318E D0 E8			bne LoadPal1_2						; Copy a page
   240 3190 B1 93		LoadPal1_3 lda (Y_Register),y
   241 3192 8D 46 D6			sta.w VBXE_CR						; Set the red component
   242 = 3194			SP2_CR3	equ *-1
   243 3195 C8				iny
   244 3196 B1 93			lda (Y_Register),y
   245 3198 8D 47 D6			sta.w VBXE_CG						; Set the green component
   246 = 319A			SP2_CG3	equ *-1
   247 319B C8				iny
   248 319C			LP1_3_B
   249 319C B1 93			lda (Y_Register),y
   250 319E 8D 48 D6			sta.w VBXE_CB						; Set the blue component and increment CSEL
   251 = 31A0			SP2_CB3	equ *-1
   252 31A1 C8				iny
