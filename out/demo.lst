    95 				; Ball arrays (struct-of-arrays), indexed by the ball number in X.
    96 				; MAX_BALLS ($40) slots per field.  The base is page-aligned and the stride
    97 				; divides 256, so no array can ever straddle a page boundary - lda abs,x on
    98 				; any field costs 4 cycles for every ball.  Occupies $5500-$57BF.
    99 = 0040			.def	MAX_BALLS						= $40	; Array capacity / live ball-count cap
   100 = 0040			.def	Bob_Stride						= $40	; Bytes per field array
   101 = 5500			Bobs	equ	$5500						; Base of the ball field arrays
   102
   103 = 5500			Bob_X_Pos_Frac		equ	Bobs+[$00*Bob_Stride]	; $5500  X sub-pixel fraction
   104 = 5540			Bob_X_Pos_Lo		equ	Bobs+[$01*Bob_Stride]	; $5540  X low byte
   105 = 5580			Bob_X_Pos_Hi		equ	Bobs+[$02*Bob_Stride]	; $5580  X high byte (X valid 0-319)
   106 = 55C0			Bob_Y_Pos_Frac		equ	Bobs+[$03*Bob_Stride]	; $55C0  Y sub-pixel fraction
   107 = 5600			Bob_Y_Pos			equ	Bobs+[$04*Bob_Stride]	; $5600  Y (valid 0-239, no hi byte)
   108 = 5640			Bob_Delta_X_Sign	equ	Bobs+[$05*Bob_Stride]	; $5640  $00 = right, $FF = left
   109 = 5680			Bob_Delta_X_Frac	equ	Bobs+[$06*Bob_Stride]	; $5680  X velocity fraction
   110 = 56C0			Bob_Delta_X			equ	Bobs+[$07*Bob_Stride]	; $56C0  X velocity integer
   111 = 5700			Bob_Delta_Y_Sign	equ	Bobs+[$08*Bob_Stride]	; $5700  $00 = down, $FF = up
   112 = 5740			Bob_Delta_Y_Frac	equ	Bobs+[$09*Bob_Stride]	; $5740  Y velocity fraction
   113 = 5780			Bob_Delta_Y			equ	Bobs+[$0A*Bob_Stride]	; $5780  Y velocity integer
   114
   115 				;-----------------------------------------------------------------------------
   116 				; Defines go here
   117 				;-----------------------------------------------------------------------------
   118 				; __VBXE_AUTO__ must NOT be defined: this code reaches the VBXE with plain
   119 				; absolute lda/sta, so VBXE_BASE has to be fixed at assembly time.  Defining it
   120 				; sets VBXE_BASE = $0000 and every register access lands in zero page.
   121 = 2000			.def	VBXE_WINDOW						= $2000
   122 = 1000			.def	VBXE_WINDOW_SIZE_4k				= $1000
   123 = 2000			.def	VBXE_WINDOW_SIZE_8k				= $2000
   124 = 3000			.def	LOAD_ADDRESS					= VBXE_WINDOW + VBXE_WINDOW_SIZE_4k
   125 = 8000			.def	SCREEN_RAM						= $8000	; Make sure this is > Mus_Song_End
   126
   127 				; Temp debug stuff
   128 = 0000			.def	DBG_SINGLE_STEP					= $00	; 00 = False else true
   129 = 0001			.def	DBG_FRAME_CHECK					= $01	; 00 = False else true.  Mutually exclusive
   130 															; with DBG_SINGLE_STEP - the space-wait makes
   131 															; every frame read as late
   132 = 0000			.def	DBG_TINY_BALL					= $00	; 01 = shrink the ball blit to 8x8.  Unloads the
   133 															; blitter 16x while leaving every CPU instruction
   134 															; in Spr_Loop byte-identical, so the ball ceiling
   135 															; then tells you which resource is the wall.
   136 															; DIAGNOSTIC ONLY - delete once it has answered.
   137 = 0030			.def	MAX_SPRITES_PAL					= $30	; (Previously was $25!)
   138 = 0018			.def	MAX_SPRITES_NTSC				= $18
   139
   140 				; Background clear height, and the ball Y clamp derived from it.
   141 				; The clear is the single biggest consumer of blitter bandwidth - 320x240 is
   142 				; 76,800 of the ~166,000 cycles the blitter gets in a PAL frame once overlay
   143 				; and attribute-map DMA are paid.  Trimming rows off the bottom is the only
   144 				; lever left that does not touch the 32x32 ball blit.
   145 				;
   146 				; BLT_BAKGRND has zoom 8x8, so its height byte moves in 8-pixel steps:
   147 				;   $1D = 240 rows (full screen)   $1C = 232   $1B = 224   $1A = 216
   148 				; Y_POS_MAX is derived so the clamp always matches the cleared area.  If these
   149 				; two ever disagree the balls leave permanent trails in the uncleared strip.
   150 = 001C			.def	CLEAR_H							= $1C	; Clear height byte -> 232 rows
   151 = 00E8			.def	CLEAR_ROWS						= [CLEAR_H+1]*8
   152 = 00C8			.def	Y_POS_MAX						= CLEAR_ROWS-32	; Lowest legal ball Y
   153
   154 				; BCB field byte offsets
   155 = 0000			.def	Src_Adr0						= $00
   156 = 0001			.def	Src_Adr1						= $01
   157 = 0002			.def	Src_Adr2						= $02
   158 = 0006			.def	Dest_Adr0						= $06
   159 = 0007			.def	Dest_Adr1						= $07
   160 = 0008			.def	Dest_Adr2						= $08
   161 = 0014			.def	Blt_Ctrl						= $14
   162
   163 				; Title Screen
   164 = 0011			.def	V_0								= $11	; 1 (Screen code used for Version in loading screen)
   165 = 0010			.def	V_1								= $10	; 0 (Screen code used for Version in loading screen)
   166 = 0015			.def	V_2								= $15	; 5 (Screen code used for Version in loading screen)
   167 = 0061			.def	V_3								= $61	; a  (Screen code used for Version in loading screen)
   168
