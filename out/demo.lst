   771 363C 8D 50 D6			sta VBXE_BL_ADR0					; Setup the blitter for memory fill operation
   772 363F A9 00			lda #$00
   773 3641 8D 52 D6			sta VBXE_BL_ADR2					; See the description of BCB at the end of this
   774 3644 A9 05			lda #$05							; Source
   775 3646 8D 51 D6			sta VBXE_BL_ADR1
   776 3649 A9 00			lda #$00
   777 364B			Setup_Cmap1_L1
   778 364B AD 53 D6			lda VBXE_BLITTER_BUSY
   779 364E C9 00			cmp #$00
   780 3650 D0 F9			bne Setup_Cmap1_L1					; Wait for blitter to finish
   781 3652 A9 01			lda #$01
   782 3654 8D 53 D6			sta VBXE_BLITTER_START				; Start the blit
   783 3657			Setup_Cmap1_L2
   784 3657 AD 53 D6			lda VBXE_BLITTER_BUSY
   785 365A C9 00			cmp #$00
   786 365C D0 F9			bne Setup_Cmap1_L2					; Wait for blitter to finish before returning
   787 365E 60				rts
   788
   789 				;-----------------------------------------------------------------------------
   790 				; Setup_Cmap2 - Sets byte 2 for all cmap entries via blitter
   791 				;-----------------------------------------------------------------------------
   792 365F			Setup_Cmap2
   793 365F A9 54			lda #BLT_SETUP_CMAP_2-BLT_BALL
   794 3661 8D 50 D6			sta VBXE_BL_ADR0					; Setup the blitter for memory fill operation
   795 3664 A9 00			lda #$00
   796 3666 8D 52 D6			sta VBXE_BL_ADR2					; See the description of BCB at the end of this
   797 3669 A9 05			lda #$05							; Source
   798 366B 8D 51 D6			sta VBXE_BL_ADR1
   799 366E A9 00			lda #$00
   800 3670			Setup_Cmap2_L1
   801 3670 AD 53 D6			lda VBXE_BLITTER_BUSY
   802 3673 C9 00			cmp #$00
   803 3675 D0 F9			bne Setup_Cmap2_L1					; Wait for blitter to finish
   804 3677 A9 01			lda #$01
   805 3679 8D 53 D6			sta VBXE_BLITTER_START				; Start the blit
   806 367C			Setup_Cmap2_L2
   807 367C AD 53 D6			lda VBXE_BLITTER_BUSY
   808 367F C9 00			cmp #$00
   809 3681 D0 F9			bne Setup_Cmap2_L2					; Wait for blitter to finish before returning
   810 3683 60				rts
   811
   812 				;-----------------------------------------------------------------------------
   813 				; Calculate_200
   814 				;   Reg1 = X_Pos_L	Object Horizontal Position (Col)
   815 				;   Reg2 = X_Pos_H	Object Horizontal Position (Col)
   816 				;   Reg3 = Y_Pos	Object Vertical Position   (Row)
   817 				;   Reg4 = Adr0	   VBXE Blitter Address
   818 				;   Reg5 = Adr1	   VBXE Blitter Address
   819 				;   Reg6 = Adr2	   VBXE Blitter Address
   820 				;   Reg7 = XDL destination high byte (either 0 or 2)
   821 				;-----------------------------------------------------------------------------
   822 3684			Calculate_200
   823 				; Because we are double buffering, we need to write to the backbuffer
   824 				; So load the buffer address from the XDL but use the other one
   825 3684 AD 5F D6			lda VBXE_MA_BSEL
   826 3687 48				pha									; Store it
   827
   828 3688 A9 80			lda #$80							; Bank $00 with global enable (XDL lives in bank $00)
   829 368A 8D 5F D6			sta VBXE_MA_BSEL
   830
   831 368D AD 05 24			lda VBXE_WINDOW + $405				; XDL Adr2 (byte 5 of XDL at VBXE_WINDOW+$400)
   832 3690 49 06			eor #$06							; Flip between $02 ($020000) and $04 ($040000)
   833 3692 85 86			sta Reg7							; Reg7 = backbuffer Adr2
   834
   835 				; Calculate the start of VRAM (Reg4, Reg5, Reg6) for the given Y-Pos
   836 3694 A9 00			lda #$00
   837 3696 85 83			sta Reg4							; Reset to initial value
   838 3698 85 85			sta Reg6							; Reset to initial value
   839 369A A5 82			lda Reg3							; Y_Pos
   840 369C 10 04			bpl Skip_Reg6						; If A <= $7F Reg6 will be 0
   841 369E A0 01			ldy #$01							; Else
   842 36A0 84 85			sty Reg6							; Reg6 = 1
   843 36A2			Skip_Reg6
   844 36A2 0A				asl									; Multiply by 2
   845 36A3 85 84			sta Reg5
   846
   847 				; Now move into that line in VRAM based on the X-Position
   848 36A5 18				clc									; Prepare to add
   849 36A6 A5 80			lda Reg1							; X_Pos_L
   850 36A8 65 83			adc Reg4							; Add Adr0
   851 36AA 85 83			sta Reg4							; Store it
   852 36AC A5 81			lda Reg2							; X_Pos_H
   853 36AE 65 84			adc Reg5							; Add Adr1
   854 36B0 85 84			sta Reg5							; Store it
   855 36B2 A9 00			lda #$00
   856 36B4 65 85			adc Reg6							; Account for overflow
   857 36B6 85 85			sta Reg6							; Store Adr2
   858
   859 				; Set Adr 2 depending on which buffer we are writing to
   860 36B8 18				clc									; Prepare to add
   861 36B9 A5 86			lda Reg7
   862 36BB 65 85			adc Reg6							; Carry flag weill NEVER be set, as value will only ever be 0-1 or 2-3
   863 36BD 85 85			sta Reg6
   864 36BF			Calculate_200_End						; This takes on average $37(55) cycles, code is $22(34) bytes TODO: Calculate new cycle time based on code to handle double buffering
   865 36BF 68				pla
   866 36C0 8D 5F D6			sta VBXE_MA_BSEL					; Restore to initial value
   867
   868 36C3 60				rts
   869
   870 				;-----------------------------------------------------------------------------
   871 				; Setup_DisplayList - Points ANTIC to a Display List that will be in VBXE RAM
   872 				;-----------------------------------------------------------------------------
   873 36C4			Setup_DisplayList
   874 36C4 AD 2F 02			lda SDMCTL
   875 36C7 48				pha									; Save it
   876
   877 36C8 A9 00			lda #$00							; Turn off ANTIC DMA
   878 36CA 8D 2F 02			sta SDMCTL							; To safely set SDLSTL
   879
   880 36CD A9 00			lda <Display_List
   881 36CF 8D 30 02			sta SDLSTL
   882 36D2 A9 59			lda >Display_List
   883 36D4 8D 31 02			sta SDLSTH
   884
   885 36D7 68				pla									; Restore it
   886 36D8 8D 2F 02			sta SDMCTL
   887
   888 36DB 60				rts									; Go Home
   889
   890 				;-----------------------------------------------------------------------------
   891 				; Generate_Colour_Map
   892 				; This will generate the 9600 byte colour map used by the VBXE
   893 				;-----------------------------------------------------------------------------
   894 36DC			Generate_Colour_Map
   895 36DC A9 00			lda #$00
   896 36DE 85 88			sta Ptr_Lo
   897 36E0 A9 06			lda #$06
   898 36E2 85 89			sta Ptr_Hi							; Initialize destination pointer to $0600
   899
   900 36E4 A9 01			lda #$01
   901 36E6 85 80			sta Reg1							; Running colour accumulator
   902
   903 36E8 A2 00			ldx #$00							; Object counter (0-15)
   904 36EA			obj_loop
   905 36EA A0 00			ldy #$00							; Row counter (0-14)
   906 36EC			row_loop
   907 36EC A9 00			lda #$00							; Default: blank row
   908 36EE C0 00			cpy #$00
   909 36F0 F0 08			beq store_colour
   910 36F2 C0 0E			cpy #$0E
   911 36F4 F0 04			beq store_colour
   912 36F6 A5 80			lda Reg1							; Non-blank row: use accumulator
   913 36F8 E6 80			inc Reg1
   914 36FA			store_colour
   915 36FA 91 88			sta (Ptr_Lo),Y
   916
   917 36FC C8				iny
   918 36FD C0 0F			cpy #$0F							; 15 rows per object
   919 36FF D0 EB			bne row_loop
   920
   921 				; Advance pointer by 15 to next object's base
   922 3701 A5 88			lda Ptr_Lo
   923 3703 18				clc
   924 3704 69 0F			adc #$0F
   925 3706 85 88			sta Ptr_Lo
   926 3708 90 02			bcc no_carry
   927 370A E6 89			inc Ptr_Hi
   928 370C			no_carry
   929 370C E8				inx
   930 370D E0 10			cpx #$10							; 16 objects
   931 370F D0 D9			bne obj_loop
   932
   933 3711 20 3A 36			jsr Setup_Cmap1						; Setup the Palette & Priority bits
   934 3714 20 18 37			jsr Setup_Colours
   935
   936 3717 60				rts
   937
   938 				;-----------------------------------------------------------------------------
   939 				; Setup_Colours
   940 				; Uses the temp table at $600 to setup the Attribute Colour Map
   941 				;-----------------------------------------------------------------------------
   942 3718			Setup_Colours
   943 				; Turn on VBXE window so we can modify the BCB
   944 3718 A9 80			lda #$80							; Copy some data into VBXE address space (XDL, Blitter control blocks (BCB))
   945 371A 8D 5F D6			sta VBXE_MA_BSEL
   946
   947 371D A2 00			ldx #$00							; Prepare to loop
   948 371F			Setup_Colours_L1
   949 371F BD 00 06			lda $600,x							; Get the colour
   950 3722 8D 64 25			sta VBXE_WINDOW+$554+$10			; BLT_SETUP_CMAP_2 starts at $0554 in VBXE bank 0, XOR Mask is offset $10
   951
   952 3725 20 5F 36			jsr Setup_Cmap2						; Setup a row of colours
   953
   954 				; Now we must do a 24-bit addition to get the next Destination Address (offset 6,7,8)
   955 3728 18				clc
   956 3729 AD 5A 25			lda VBXE_WINDOW+$554+$06			; Dest Addr 2
   957 372C 69 28			adc #$28							; Advance by one line ($28 bytes/line)
   958 372E 8D 5A 25			sta VBXE_WINDOW+$554+$06			; Dest Addr 2
   959
   960 3731 AD 5B 25			lda VBXE_WINDOW+$554+$07			; Dest Addr 1
   961 3734 69 00			adc #$00
   962 3736 8D 5B 25			sta VBXE_WINDOW+$554+$07			; Dest Addr 1
   963
   964 3739 AD 5C 25			lda VBXE_WINDOW+$554+$08			; Dest Addr 0
   965 373C 69 00			adc #$00
   966 373E 8D 5C 25			sta VBXE_WINDOW+$554+$08			; Dest Addr 1
   967
   968 3741 E8				inx
   969 3742 E0 EF			cpx #$EF
   970 3744 D0 D9			bne Setup_Colours_L1
   971
   972 3746 60				rts
   973 				;-----------------------------------------------------------------------------
   974 				; Subroutines END
   975 				;-----------------------------------------------------------------------------
   976
   977 				;-----------------------------------------------------------------------------
   978 				; Data Tables go here
   979 				;-----------------------------------------------------------------------------
   980 				; 37 velocity patterns - one per sprite, every (int,frac) pair unique
   981 				; X: integer $00-$03 cycles with period 4; frac rotates +$40 each int group
   982 				; Y: integer offset by 1 ($01-$03,$00); frac rotates +$20 relative to X â†’ no correlation
   983 3747			Init_Delta_X
   984 3747 01 01 02 03 00 01 + 	dta $01,$01,$02,$03,$00,$01,$02,$03,$00,$01,$02,$03,$00,$01,$02,$03
   985 3757 00 01 02 03 00 01 + 	dta $00,$01,$02,$03,$00,$01,$02,$03,$00,$01,$02,$03,$00,$01,$02,$03
   986 3767 00 01 02 03 00		dta $00,$01,$02,$03,$00
   987 376C			Init_Delta_X_Frac
   988 376C 00 40 80 C0 10 50 + 	dta $00,$40,$80,$C0,$10,$50,$90,$D0,$20,$60,$A0,$E0,$30,$70,$B0,$F0
   989 377C 40 80 C0 00 50 90 + 	dta $40,$80,$C0,$00,$50,$90,$D0,$10,$60,$A0,$E0,$20,$70,$B0,$F0,$30
   990 378C 80 C0 00 40 90		dta $80,$C0,$00,$40,$90
   991 3791			Init_Delta_Y
   992 3791 06 02 03 00 01 02 + 	dta $06,$02,$03,$00,$01,$02,$03,$00,$01,$02,$03,$01,$01,$02,$03,$00
   993 37A1 01 02 03 00 01 02 + 	dta $01,$02,$03,$00,$01,$02,$03,$00,$01,$02,$03,$00,$01,$02,$03,$00
   994 37B1 01 02 03 00 01		dta $01,$02,$03,$00,$01
   995 37B6			Init_Delta_Y_Frac
   996 37B6 00 60 A0 E0 30 70 + 	dta $00,$60,$A0,$E0,$30,$70,$B0,$F0,$40,$80,$C0,$00,$50,$90,$D0,$10
   997 37C6 60 A0 E0 20 70 B0 + 	dta $60,$A0,$E0,$20,$70,$B0,$F0,$30,$80,$C0,$00,$40,$90,$D0,$10,$50
   998 37D6 A0 E0 20 60 B0		dta $A0,$E0,$20,$60,$B0
   999
  1000 				; Standard Atari ROM font for 3 and 7, laid out by hand, then auto-generated tables based on my grid
  1001 37DB			Init_Pos_X_Lo
  1002 37DB 12 24 36 48 5A 6C + 	dta $12,$24,$36,$48,$5A,$6C,$A2,$B4,$C6,$D8,$EA,$FC,$48,$5A,$A2,$EA	; Objs $00-$0F
  1003 37EB FC 36 48 D8 EA 48 + 	dta $FC,$36,$48,$D8,$EA,$48,$5A,$C6,$D8,$12,$24,$5A,$6C,$B4,$C6,$24	; Objs $10-$1F
  1004 37FB 36 48 5A B4 C6		dta $36,$48,$5A,$B4,$C6				; Objs $20-$24
  1005 3800			Init_Pos_Y
  1006 3800 0D 0D 0D 0D 0D 0D + 	dta $0D,$0D,$0D,$0D,$0D,$0D,$0D,$0D,$0D,$0D,$0D,$0D,$1A,$1A,$1A,$1A	; Objs $00-$0F
  1007 3810 1A 27 27 27 27 34 + 	dta $1A,$27,$27,$27,$27,$34,$34,$34,$34,$41,$41,$41,$41,$41,$41,$4E	; Objs $10-$1F
  1008 3820 4E 4E 4E 4E 4E		dta $4E,$4E,$4E,$4E,$4E				; Objs $20-$24
  1009
