   607 3561 8A				txa
   608 3562 A8				tay
   609 3563 B9 B6 37			lda Init_Delta_Y_Frac,y
   610 3566 A0 09			ldy #Spr_Delta_Y_Frac
   611 3568 91 88			sta (Ptr_Lo),y
   612
   613 356A A9 00			lda #$00							; Initially moving down
   614 356C A0 08			ldy #Spr_Delta_Y_Sign
   615 356E 91 88			sta (Ptr_Lo),y
