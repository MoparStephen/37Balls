   702 				;-----------------------------------------------------------------------------
   703 				; Handle_Keys
   704 				;-----------------------------------------------------------------------------
   705 35DC			Handle_Keys
   706 				; If present, the next lines will allow a "jump to exit" on a specific key press
   707 35DC AD FC 02			lda CH
   708 35DF C9 2F			cmp #$2F							; Press Q to quit
   709 35E1 F0 43			beq Exit_Long
   710 35E3 C9 32			cmp #$32							; 0
   711 35E5 F0 0F			beq Handle_0
   712 35E7 C9 06			cmp #$06							; + increase the ball count
   713 35E9 F0 11			beq Handle_Plus
   714 35EB C9 0E			cmp #$0E							; - decrease the ball count
   715 35ED F0 18			beq Handle_Minus
   716 				.if DBG_FRAME_CHECK
   717 35EF C9 28			cmp #$28							; R reset the dropped-frame latch
   718 35F1 F0 1F			beq Handle_Reset
   719 				.endif
   720 35F3			Handle_Keys_Done						; No more keys to test
   721 35F3 4C 20 36			jmp Read_Key_Done
   722
   723 35F6			Handle_0
