     1 2500			BLT_BALL
     2 2500-2568> 00 00 01		dta $00,$00,$01						; Source address
     3 2503 20 00			dta $20,$00							; Source step y
     4 2505 01				dta $01								; Source step x
     5 2506 00 00 02			dta $00,$00,$02						; Destination address
     6 2509 00 02			dta $00,$02							; Destination step y
     7 250B 01				dta $01								; Destination step x
     8 				.if DBG_TINY_BALL
     9 					dta $07,$00							; Width  (8 - DBG_TINY_BALL diagnostic)
    10 					dta $07								; Height (8 - DBG_TINY_BALL diagnostic)
    11 				.else
    12 250C 1F 00			dta $1F,$00							; Width
    13 250E 1F				dta $1F								; Height
    14 				.endif
    15 250F FF				dta $FF								; And mask
    16 2510 00				dta $00								; Xor mask
    17 2511 00				dta $00								; Collision and mask
    18 2512 00				dta $00								; Zoom
    19 2513 00				dta $00								; Pattern feature
    20 2514 01				dta $01								; Control
    21
    22 2515			BLT_BAKGRND
    23 2515 00 00 00			dta $00,$00,$00						; Source address
    24 2518 00 00			dta $00,$00							; Source step y
    25 251A 00				dta $00								; Source step x
    26 251B 00 00 02			dta $00,$00,$02						; Destination address
    27 251E 00 02			dta $00,$02							; Destination step y
    28 2520 01				dta $01								; Destination step x
    29 2521 27 00			dta $27,$00							; Width
    30 2523 1C				dta CLEAR_H							; Height (see CLEAR_H in demo.asm)
    31 2524 00				dta $00								; And mask (and mask equal to 0, memory will be filled with xor mask)
    32 2525 00				dta $00								; Xor mask
    33 2526 00				dta $00								; Collision and mask
    34 2527 77				dta $77								; Zoom
    35 2528 00				dta $00								; Patter feature
    36 2529 00				dta $00								; Control
    37
    38 				; Clear 496kB (leave bottom 16kB for the SVBXE.SYS driver)
    39 				; 496x16 zoom 8x8 clear blit (this takes 2 frames)
    40 252A			BLT_CLEAR
    41 252A 00 00 00			dta $00,$00,$00						; Source address
    42 252D 00 00			dta $00,$00							; Source step y
    43 252F 00				dta $00								; Source step x
    44 2530 FF BF 07			dta $FF,$BF,$07						; Destination address
    45 2533 80 F0			dta a(-$0F80)						; Destination step y (backwards 3968 bytes) - NOTE: this equals 496 * zoom factor of 8
    46 2535 FF				dta -$01							; Destination step x (backwards	1 byte)
    47 2536 EF 01			dta $EF,$01							; Width-1  (495)	496 * 8 bytes wide
    48 2538 0F				dta $0F								; Height-1 (15)		 16 * 8 bytes high
    49 2539 00				dta $00								; And mask (And mask equal to 0 so clear)
    50 253A 00				dta $00								; Xor mask (will be filled with xor mask)
    51 253B 00				dta $00								; Collision and mask
    52 253C 77				dta $77								; Zoom (BLT_ZOOMY = 7, BLT_ZOOMX = 7 so 8Y*8X)
    53 253D 00				dta $00								; Pattern feature
    54 253E 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    55
    56 				; Fill the ColourMap area ($60000-$62580, 9600 bytes) with $50 every 4 bytes
    57 				; This sets up the Palette & Priority bytes for the entire Colour Map
    58 				; 10 cells/line (32-pixel cells) x 4 bytes/cell = $28 bytes/line, 240 lines
    59 253F			BLT_SETUP_CMAP_1
    60 253F 00 00 00			dta $00,$00,$00						; Source address
    61 2542 00 00			dta $00,$00							; Source step y
    62 2544 00				dta $00								; Source step x
    63 2545 03 00 06			dta $03,$00,$06						; Destination address ($60003)
    64 2548 28 00			dta $28,$00							; Destination step y ($28 bytes/line)
    65 254A 04				dta $04								; Destination step x
    66 254B 09 00			dta $09,$00							; Width (9 = 10 cells/line, count-1)
    67 254D EF				dta $EF								; Height ($F0)
    68 254E 00				dta $00								; And mask
    69 254F 50				dta $50								; Xor mask
    70 2550 00				dta $00								; Collision and mask
    71 2551 00				dta $00								; Zoom
    72 2552 00				dta $00								; Pattern feature
    73 2553 00				dta $00								; Control
    74
    75 				; Fill the ColourMap area with a single line ($28 bytes) of
    76 				; Local substitute of the COLPF1 register (GTIA)
    77 				; This BCB gets modified before each call
    78 				; Starting address increments by $28 each time
    79 				; Xor mask pulls values from the temp table at $0600
    80 2554			BLT_SETUP_CMAP_2
    81 2554 00 00 00			dta $00,$00,$00						; Source address
    82 2557 00 00			dta $00,$00							; Source step y
    83 2559 00				dta $00								; Source step x
    84 255A 01 00 06			dta $01,$00,$06						; Destination address ($60001)
    85 255D 28 00			dta $28,$00							; Destination step y ($28 bytes/line)
    86 255F 04				dta $04								; Destination step x
    87 2560 09 00			dta $09,$00							; Width (9 = 10 cells/line, count-1)
    88 2562 00				dta $00								; Height ($01)
    89 2563 00				dta $00								; And mask
    90 2564 69				dta $69								; Xor mask
    91 2565 00				dta $00								; Collision and mask
    92 2566 00				dta $00								; Zoom
    93 2567 00				dta $00								; Pattern feature
    94 2568 00				dta $00								; Control
