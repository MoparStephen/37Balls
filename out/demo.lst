   886 				;-----------------------------------------------------------------------------
   887 				; Generate_Colour_Map
   888 				; This will generate the 9600 byte colour map used by the VBXE
   889 				;-----------------------------------------------------------------------------
   890 36D6			Generate_Colour_Map
   891 36D6 A9 00			lda #$00
   892 36D8 85 88			sta Ptr_Lo
   893 36DA A9 06			lda #$06
   894 36DC 85 89			sta Ptr_Hi							; Initialize destination pointer to $0600
   895
   896 36DE A9 01			lda #$01
   897 36E0 85 80			sta Reg1							; Running colour accumulator
   898
   899 36E2 A2 00			ldx #$00							; Object counter (0-15)
   900 36E4			obj_loop
   901 36E4 A0 00			ldy #$00							; Row counter (0-14)
   902 36E6			row_loop
   903 36E6 A9 00			lda #$00							; Default: blank row
   904 36E8 C0 00			cpy #$00
   905 36EA F0 08			beq store_colour
   906 36EC C0 0E			cpy #$0E
   907 36EE F0 04			beq store_colour
   908 36F0 A5 80			lda Reg1							; Non-blank row: use accumulator
   909 36F2 E6 80			inc Reg1
   910 36F4			store_colour
   911 36F4 91 88			sta (Ptr_Lo),Y
   912
   913 36F6 C8				iny
   914 36F7 C0 0F			cpy #$0F							; 15 rows per object
   915 36F9 D0 EB			bne row_loop
   916
   917 				; Advance pointer by 15 to next object's base
   918 36FB A5 88			lda Ptr_Lo
   919 36FD 18				clc
   920 36FE 69 0F			adc #$0F
   921 3700 85 88			sta Ptr_Lo
   922 3702 90 02			bcc no_carry
   923 3704 E6 89			inc Ptr_Hi
   924 3706			no_carry
   925 3706 E8				inx
   926 3707 E0 10			cpx #$10							; 16 objects
   927 3709 D0 D9			bne obj_loop
   928
   929 370B 20 47 36			jsr Setup_Cmap1						; Setup the Palette & Priority bits
   930 370E 20 12 37			jsr Setup_Colours
