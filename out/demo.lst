   325 				;-----------------------------------------------------------------------------
   326 				; Subroutines BEGIN
   327 				;-----------------------------------------------------------------------------
   328 				;-----------------------------------------------------------------------------
   329 				; Reverse_X - 2's complement negate of Delta_X_Sign:Delta_X:Delta_X_Frac
   330 				; Ptr_Lo/Ptr_Hi must point to the current Sprite struct
   331 				;-----------------------------------------------------------------------------
   332 33C2			Reverse_X
   333 33C2 38				sec
   334 33C3 A0 06			ldy #Spr_Delta_X_Frac
   335 33C5 A9 00			lda #$00
   336 33C7 F1 88			sbc (Ptr_Lo),y
   337 33C9 91 88			sta (Ptr_Lo),y
   338 33CB A0 07			ldy #Spr_Delta_X
   339 33CD A9 00			lda #$00
   340 33CF F1 88			sbc (Ptr_Lo),y
   341 33D1 91 88			sta (Ptr_Lo),y
   342 33D3 A0 05			ldy #Spr_Delta_X_Sign
   343 33D5 B1 88			lda (Ptr_Lo),y
   344 33D7 49 FF			eor #$FF
   345 33D9 91 88			sta (Ptr_Lo),y
   346 33DB 60				rts
   347
   348 				;-----------------------------------------------------------------------------
   349 				; Reverse_Y - 2's complement negate of Delta_Y_Sign:Delta_Y:Delta_Y_Frac
   350 				;-----------------------------------------------------------------------------
   351 33DC			Reverse_Y
   352 33DC 38				sec
   353 33DD A0 09			ldy #Spr_Delta_Y_Frac
