   355 33E1 F1 88			sbc (Ptr_Lo),y
   356 33E3 91 88			sta (Ptr_Lo),y
   357 33E5 A0 0A			ldy #Spr_Delta_Y
   358 33E7 A9 00			lda #$00
   359 33E9 F1 88			sbc (Ptr_Lo),y
   360 33EB 91 88			sta (Ptr_Lo),y
   361 33ED A0 08			ldy #Spr_Delta_Y_Sign
   362 33EF B1 88			lda (Ptr_Lo),y
   363 33F1 49 FF			eor #$FF
   364 33F3 91 88			sta (Ptr_Lo),y
   365 33F5 60				rts
