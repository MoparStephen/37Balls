    22 				;-----------------------------------------------------------------------------
    23 				; Ball Data Layout (struct-of-arrays)
    24 				;-----------------------------------------------------------------------------
    25 				; Each field is its own flat array indexed by the ball number in X, so every
    26 				; access is a single lda/sta abs,x - no (Ptr_Lo),y indirection, no per-ball
    27 				; pointer arithmetic, and Y is left free.  Addresses are set up below at Bobs.
    28 				;
    29 				;	X_Pos_Frac							; Horizontal position (Fractional)
    30 				;	X_Pos_Lo							; Horizontal position
    31 				;	X_Pos_Hi							; Horizontal position (Valid Values 0-319)
    32 				;	Y_Pos_Frac							; Vertical position (Fractional)
    33 				;	Y_Pos								; Vertical position (valid values 0-239)
    34 				;	Delta_X_Sign						; X-Delta Sign (toggles betwen $00:Right, $FF:Left)
    35 				;	Delta_X_Frac						; Fractional X-Delta
    36 				;	Delta_X								; X-Delta (Valid Values) (+ = move right, - = move left)
    37 				;	Delta_Y_Sign						; Y-Delta Sign (toggles betwen $00:Down, $FF:Up)
    38 				;	Delta_Y_Frac						; Fractional Y-Delta
    39 				;	Delta_Y								; Y-Delta (Valid Values) (+ = move down, - = move up)
    40
    41 				;-----------------------------------------------------------------------------
    42 				; Variables go here
    43 				;-----------------------------------------------------------------------------
    44 				; Page 0 user data ($80 to $FF with some reserved for OS)
    45 				.zpvar Reg1				.byte			; Multi-Use Variables
    46 				.zpvar Reg2				.byte			; Multi-Use Variables
    47 				.zpvar Reg3				.byte			; Multi-Use Variables
    48 				.zpvar Reg4				.byte			; Multi-Use Variables
    49 				.zpvar Reg5				.byte			; Multi-Use Variables
    50 				.zpvar Reg6				.byte			; Multi-Use Variables
    51 				.zpvar Reg7				.byte			; Multi-Use Variables
    52 				.zpvar Reg8				.byte			; Multi-Use Variables
    53 				.zpvar Ptr_Lo			.byte			; Lo byte of pointer
    54 				.zpvar Ptr_Hi			.byte			; Hi byte of pointer
    55 				.zpvar Do_Motion		.byte			; Allows pausing motion for the initial start
    56 				.zpvar Num_Sprites		.byte			; Keeps track of the number of sprites we are displaying
    57
