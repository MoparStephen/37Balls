   576 3532 A8				tay
   577 3533 B9 00 38			lda Init_Pos_Y,y
   578 3536 A0 04			ldy #Spr_Y_Pos
   579 3538 91 88			sta (Ptr_Lo),y
   580 353A A9 00			lda #$00
   581 353C A0 03			ldy #Spr_Y_Pos_Frac
   582 353E 91 88			sta (Ptr_Lo),y
   583
   584 					; Velocity from tables, indexed directly by object number
   585 3540 8A				txa
   586 3541 A8				tay
   587 3542 B9 47 37			lda Init_Delta_X,y
   588 3545 A0 07			ldy #Spr_Delta_X
   589 3547 91 88			sta (Ptr_Lo),y
   590
   591 3549 8A				txa
   592 354A A8				tay
   593 354B B9 6C 37			lda Init_Delta_X_Frac,y
   594 354E A0 06			ldy #Spr_Delta_X_Frac
   595 3550 91 88			sta (Ptr_Lo),y
   596
   597 3552 A9 00			lda #$00							; Initially moving right
   598 3554 A0 05			ldy #Spr_Delta_X_Sign
   599 3556 91 88			sta (Ptr_Lo),y
   600
   601 3558 8A				txa
   602 3559 A8				tay
