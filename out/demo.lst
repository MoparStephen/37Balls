    18 2417 EE				dta $EE								; XDLC_RPTL (1 byte)
    19 2418 00 00 02 00 02		dta $00,$00,$02,$00,$02				; XDLC_OVADR (5 bytes) - same Screen 1/2 addresses as XDL_Attribute
    20 241D 11 FF			dta %00010001,$FF					; XDLC_OVATT (2 bytes)
    21 				;		 76543210  76543210
