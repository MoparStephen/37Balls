   411 				;-----------------------------------------------------------------------------
   412 				; Reverse_X - 2's complement negate of Delta_X_Sign:Delta_X:Delta_X_Frac
   413 				; X = ball index
   414 				;-----------------------------------------------------------------------------
   415 3412			Reverse_X
   416 3412 38				sec
   417 3413 A9 00			lda #$00
   418 3415 FD 80 56			sbc Bob_Delta_X_Frac,x
   419 3418 9D 80 56			sta Bob_Delta_X_Frac,x
   420 341B A9 00			lda #$00
   421 341D FD C0 56			sbc Bob_Delta_X,x
   422 3420 9D C0 56			sta Bob_Delta_X,x
   423 3423 BD 40 56			lda Bob_Delta_X_Sign,x
   424 3426 49 FF			eor #$FF
   425 3428 9D 40 56			sta Bob_Delta_X_Sign,x
   426 342B 60				rts
