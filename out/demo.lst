   725 35F9 4C 20 36			jmp Read_Key_Done
   726
   727 35FC			Handle_Plus
   728 35FC A5 8B			lda Num_Sprites
   729 35FE C9 40			cmp #MAX_BALLS
   730 3600 B0 1E			bcs Read_Key_Done					; Already at the array capacity
   731 3602 E6 8B			inc Num_Sprites
   732 3604 4C 20 36			jmp Read_Key_Done
   733
   734 3607			Handle_Minus
   735 3607 A5 8B			lda Num_Sprites
   736 3609 C9 02			cmp #$02
   737 360B 90 13			bcc Read_Key_Done					; Never let it reach zero - the loops test
   738 360D C6 8B			dec Num_Sprites						; equality, so 0 would run 256 iterations
   739 360F 4C 20 36			jmp Read_Key_Done
   740
   741 				.if DBG_FRAME_CHECK
   742 3612			Handle_Reset
   743 3612 A9 00			lda #$00
   744 3614 8D 8C 04			sta Frame_Drops						; Clear the sticky yellow
   745 3617 8D 8B 04			sta Frame_Late
   746 361A 8D C8 02			sta COLOR4
   747 361D 4C 20 36			jmp Read_Key_Done
   748 				.endif
